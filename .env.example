# Local development environment (docker compose). Copy to `.env` and fill in.
# NEVER commit real values. Production variables are set in the Railway
# dashboard instead (see README.md).

# Required for the first boot: Drupal admin password. No default, no fixed
# value — first boot fails fast if this is empty.
DRUPAL_ACCOUNT_PASS=

# Optional: host port for the local web service (docker compose only).
# WEB_PORT=8080
